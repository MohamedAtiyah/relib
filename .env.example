# Meta Model API (https://dev.meta.ai/docs). Create a key in the dashboard under API keys.
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL_SPARK=muse-spark-1.3

# true = serve cached results only, no model calls (use for the public demo)
DEMO_MODE=false

# Optional. OpenAlex allows a small shared daily budget without a key.
OPENALEX_API_KEY=
OPENALEX_MAILTO=
