# Meta Model API (https://dev.meta.ai/docs). Create a key in the dashboard under API keys.
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL_SPARK=muse-spark-1.3

# true = serve cached results only, no model calls (use for the public demo)
DEMO_MODE=false

# Optional. OpenAlex allows a small shared daily budget without a key.
OPENALEX_API_KEY=
OPENALEX_MAILTO=

# Clerk (clerk.com → new application). Only the publishable key is meant to be public.
# Leave both empty in development to use Clerk's keyless mode.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Neon (neon.com → new project → connection string). Run `npm run db:migrate` once.
DATABASE_URL=

# Vercel Blob (Vercel → Storage → Blob, private store) for uploaded PDFs
BLOB_READ_WRITE_TOKEN=
