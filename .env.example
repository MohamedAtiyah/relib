# Meta Model API (https://dev.meta.ai/docs). META_MODEL_CODE is optional: the code agent falls back to Muse Spark.
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL_SPARK=muse-spark-1.3
META_MODEL_CODE=

# Optional. OpenAlex allows a small shared daily budget without a key.
OPENALEX_API_KEY=
OPENALEX_MAILTO=

# Clerk. Only the publishable key is meant to be public.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Neon connection string. Run `npm run db:migrate` after setting it.
DATABASE_URL=

# Cloudflare R2, private bucket for uploaded materials
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# E2B cloud sandbox for compiled languages
E2B_API_KEY=

# GitHub OAuth app, only for Push to GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# true switches live AI off for everyone
DEMO_MODE=false
